---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}

const {
  title = 'BookMyDegree — Distance Degree Guidance in India',
  description =
    'BookMyDegree helps housewives, working professionals, retired people and anyone else earn a recognised distance degree — we help you choose the program and handle the admission paperwork.',
  current = '',
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Motion only hides content when JS is running. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#faf6ee" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Nav current={current} />

    <slot />

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="footer-brandline">
              <Logo desc="Distance degrees & career guidance" />
            </div>

            <div class="footer-utility">
              <a href="/counselling">Counselling</a>
              <a href="/#sessions">Sessions</a>
              <a href="/#inquire">Contact us</a>
              <a href="mailto:info@bookmydegree.in">info@bookmydegree.in</a>
            </div>

            <p class="footer-say">
              Distance degrees for working people, homemakers, retired
              professionals — anyone who needs a qualification without
              attending a campus every day.
            </p>

            <div class="footer-socials">
              <a href="https://wa.me/919667571982" aria-label="Chat on WhatsApp" target="_blank" rel="noopener noreferrer">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.94.56 3.75 1.53 5.28L2 22l5.02-1.68a9.8 9.8 0 0 0 5.02 1.38h.01c5.44 0 9.84-4.4 9.84-9.84S17.48 2 12.04 2Zm5.76 13.9c-.24.68-1.4 1.3-1.93 1.35-.53.05-1.02.15-3.44-.9-2.9-1.28-4.7-4.3-4.84-4.5-.14-.2-1.13-1.5-1.13-2.87 0-1.36.71-2.03.96-2.31.25-.28.55-.35.73-.35.18 0 .37 0 .53.01.17.01.4-.06.62.48.23.55.79 1.9.86 2.04.07.14.11.3.02.48-.09.18-.14.29-.28.45-.14.16-.29.36-.42.48-.14.14-.29.29-.12.57.17.28.75 1.24 1.61 2.01 1.11.99 2.04 1.3 2.32 1.44.28.14.45.12.61-.07.17-.19.71-.83.9-1.11.19-.28.38-.23.64-.14.26.09 1.65.78 1.93.92.28.14.47.21.54.33.07.12.07.7-.17 1.38Z" />
                </svg>
              </a>
              <a href="tel:+919667571982" aria-label="Call us">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6.6 3.5h2.2l1.6 4-1.9 1.4a12.5 12.5 0 0 0 6 6l1.4-1.9 4 1.6v2.2a2.1 2.1 0 0 1-2.3 2.1A16.8 16.8 0 0 1 4.5 5.8 2.1 2.1 0 0 1 6.6 3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>

          <nav class="footer-nav" aria-label="Footer">
            <div class="footer-col">
              <h3>Programs</h3>
              <ul role="list">
                <li><a href="/programs/commerce">Commerce</a></li>
                <li><a href="/programs/management">Management</a></li>
                <li><a href="/programs/computing">Computing</a></li>
                <li><a href="/programs/arts">Arts &amp; Humanities</a></li>
              </ul>
            </div>
            <div class="footer-col">
              <h3>Guidance</h3>
              <ul role="list">
                <li><a href="/counselling">Career counselling</a></li>
                <li><a href="/#sessions">Sessions</a></li>
                <li><a href="/#inquire">Book a call</a></li>
              </ul>
            </div>
          </nav>
        </div>

        <div class="footer-bottom">
          <p class="footer-legal">
            &copy; <span data-year>{year}</span> BookMyDegree. Guidance and
            admission support, India.
          </p>
          <p class="footer-legal">
            Degrees are awarded by the institution, not by us.
          </p>
        </div>
      </div>
    </footer>

    <script>
      (function () {
        const doc = document.documentElement;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Two frames so the masked lines have a painted start state.
        requestAnimationFrame(() => requestAnimationFrame(() => doc.classList.add('is-ready')));
        window.setTimeout(() => doc.classList.add('is-ready'), 1200);

        const yearEl = document.querySelector('[data-year]');
        if (yearEl) yearEl.textContent = String(new Date().getFullYear());

        /* ---------------- Reveals ---------------- */
        // A rect check driven by the scroll loop rather than IntersectionObserver.
        // An observer that is throttled or never fires would leave content
        // permanently invisible; this always resolves.
        const pending = new Set(
          document.querySelectorAll<HTMLElement>('.reveal, [data-reveal-group]')
        );

        function revealInView() {
          if (!pending.size) return;
          const vh = window.innerHeight;
          pending.forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.bottom > 0 && r.top < vh * 0.94) {
              el.classList.add('inview');
              pending.delete(el);
            }
          });
        }

        if (reduce) {
          pending.forEach((el) => el.classList.add('inview'));
          pending.clear();
        }

        /* ---------------- Scroll state ---------------- */
        const nav = document.getElementById('site-nav');
        const heroWrap = document.querySelector<HTMLElement>('[data-hero-wrap]');
        let queued = false;

        const onScroll = () => {
          const y = window.scrollY;

          if (nav) {
            nav.classList.toggle('is-solid', y > 40);
            nav.classList.toggle('is-condensed', y > 120);
          }

          if (heroWrap) {
            const span = heroWrap.offsetHeight - window.innerHeight;
            const p = span > 0 ? Math.min(1, Math.max(0, y / span)) : 0;
            heroWrap.style.setProperty('--hero-p', p.toFixed(3));
          }

          revealInView();
          queued = false;
        };

        window.addEventListener(
          'scroll',
          () => {
            if (!queued) {
              queued = true;
              requestAnimationFrame(onScroll);
            }
          },
          { passive: true }
        );
        onScroll();

        /* ---------------- Card rails ---------------- */
        document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
          const vp = rail.querySelector<HTMLElement>('[data-rail-viewport]');
          const fill = rail.querySelector<HTMLElement>('[data-rail-fill]');
          const prev = rail.querySelector<HTMLButtonElement>('[data-rail-prev]');
          const next = rail.querySelector<HTMLButtonElement>('[data-rail-next]');
          if (!vp) return;

          const step = () => {
            const card = vp.querySelector<HTMLElement>('.rail-card');
            if (!card) return vp.clientWidth * 0.8;
            const parent = card.parentElement as HTMLElement;
            const gap = parseFloat(getComputedStyle(parent).columnGap) || 24;
            return card.getBoundingClientRect().width + gap;
          };

          const update = () => {
            const max = vp.scrollWidth - vp.clientWidth;
            if (fill) {
              fill.style.width = max > 0 ? `${Math.min(100, (vp.scrollLeft / max) * 100)}%` : '0%';
            }
            if (prev) prev.disabled = vp.scrollLeft <= 2;
            if (next) next.disabled = vp.scrollLeft >= max - 2;
          };

          prev?.addEventListener('click', () => vp.scrollBy({ left: -step(), behavior: 'smooth' }));
          next?.addEventListener('click', () => vp.scrollBy({ left: step(), behavior: 'smooth' }));
          vp.addEventListener('scroll', update, { passive: true });

          // Drag to scroll, mouse only; touch already scrolls natively.
          let down = false;
          let startX = 0;
          let startLeft = 0;
          let moved = false;

          vp.addEventListener('pointerdown', (e) => {
            if (e.pointerType !== 'mouse') return;
            down = true;
            moved = false;
            startX = e.clientX;
            startLeft = vp.scrollLeft;
            vp.style.scrollSnapType = 'none';
          });

          vp.addEventListener('pointermove', (e) => {
            if (!down) return;
            const dx = e.clientX - startX;
            if (Math.abs(dx) > 4) moved = true;
            vp.scrollLeft = startLeft - dx;
          });

          const end = () => {
            if (!down) return;
            down = false;
            vp.style.scrollSnapType = '';
          };

          vp.addEventListener('pointerup', end);
          vp.addEventListener('pointerleave', end);
          vp.addEventListener('pointercancel', end);
          vp.addEventListener(
            'click',
            (e) => {
              if (moved) {
                e.preventDefault();
                e.stopPropagation();
              }
            },
            true
          );

          update();
          window.addEventListener('resize', update);
        });
      })();
    </script>
  </body>
</html>
